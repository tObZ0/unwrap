# ─────────────────────────────────────────────────────────────────────────────
# UNWRAP configuration. Copy to .env.local for development.
# Everything is server-side unless prefixed NEXT_PUBLIC_. Never put secrets in
# NEXT_PUBLIC_ variables: those are embedded in the browser bundle.
# Nothing is strictly required to start the app: without any variables UNWRAP
# runs with public RPCs, Blockscout/Sourcify lookups, in-memory storage, no AI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ─────────────────────────────── optional (recommended in production)
# PostgreSQL (Neon, Supabase, RDS, local). Without it reports live in memory and
# are lost on restart. Apply the schema with: npm run db:migrate
DATABASE_URL=
# DATABASE_POOL_MAX=5
# Set to 1 only if your provider uses a certificate Node cannot verify.
# DATABASE_SSL_NO_VERIFY=

# ── AI explanations ─────────────────────── optional
# AI_PROVIDER: "anthropic" (default) or "openai" (any OpenAI-compatible API).
AI_PROVIDER=anthropic
AI_API_KEY=
# Anthropic default: claude-sonnet-5-5. Required for "openai".
AI_MODEL=
# Only for AI_PROVIDER=openai; must be https. Default https://api.openai.com/v1
# AI_BASE_URL=

# ── RPC endpoints ───────────────────────── optional, recommended for production
# Each accepts a comma-separated list of https URLs, tried before the public
# fallback. Public endpoints are rate-limited and not meant for production.
# Robinhood recommends Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BNB_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=

# ── Source verification ─────────────────── optional
# Etherscan API V2 (one key for Ethereum, Base, Arbitrum, BNB, Optimism, Polygon,
# Avalanche). Free keys do not cover every chain. Robinhood uses Blockscout and
# needs no key; Sourcify is always tried as a keyless fallback.
ETHERSCAN_API_KEY=

# ── Slither worker ──────────────────────── optional
# URL of the isolated worker in ./worker (never run Slither inside the web app).
SLITHER_WORKER_URL=
SLITHER_WORKER_TOKEN=

# ── Limits ──────────────────────────────── optional
# RATE_LIMIT_ANALYZE_PER_MIN=8
# RATE_LIMIT_ASK_PER_MIN=10
# Salt for hashing client IPs in rate-limit keys (IPs are never stored raw).
RATE_LIMIT_SALT=
# Reuse a public report for the same contract for this many seconds (0 = never).
# ANALYSIS_CACHE_SECONDS=600
# ANALYSIS_TIMEOUT_MS=170000

# ── Networks ────────────────────────────── optional
# Comma-separated ids to hide, e.g. "bsc,polygon".
# UNWRAP_DISABLED_NETWORKS=
# Local dev chain (anvil/hardhat). localhost only; ignored in production unless
# UNWRAP_ALLOW_LOCAL_DEVNET_IN_PRODUCTION=1.
# UNWRAP_LOCAL_DEVNET_RPC_URL=http://127.0.0.1:8545
# UNWRAP_LOCAL_DEVNET_CHAIN_ID=31337

# ── Public (safe to expose) ─────────────── optional
# Footer social links render only when set (https only).
# NEXT_PUBLIC_SOCIAL_X_URL=
# NEXT_PUBLIC_SOCIAL_GITHUB_URL=
# NEXT_PUBLIC_SOCIAL_DISCORD_URL=
